. * --- 9. Regresión por sector, matriz J() y exportación a Excel ---
. 
. levelsof `sectorvar', local(sectores)
`"Agricultura"' `"Comercio"' `"Construcción"' `"Educación"' `"Industria"' `"Servicios"'

. local k : word count `sectores'

. matrix R = J(`k', 3, .)

. 
. local i = 1

. foreach s of local sectores {
  2.     quietly regress `depvar' `educvar' if `sectorvar' == "`s'"
  3.     matrix R[`i', 1] = _b[`educvar']
  4.     matrix R[`i', 2] = _se[`educvar']
  5.     matrix R[`i', 3] = e(N)
  6.     local i = `i' + 1
  7. }

. 
. matrix colnames R = beta_educ ee n

. matrix rownames R = `sectores'

. matrix list R, format(%9.0f)

R[6,3]
               beta_educ         ee          n
  Agricultura      37519       7556         13
     Comercio      24487       8529          6
 Construcción      23783      14122          5
    Educación      37368      12642          7
    Industria      42713      14514          9
    Servicios      32308       7924         15

. 
. putexcel set "output/tarea_t5_por_sector.xlsx", replace

. putexcel A1 = ("Sector") B1 = ("Beta educ") C1 = ("Error est.") D1 = ("n")
file output/tarea_t5_por_sector.xlsx saved

. putexcel B2 = matrix(R)
file output/tarea_t5_por_sector.xlsx saved

. 
. local fila = 2

. foreach s of local sectores {
  2.     putexcel A`fila' = ("`s'")
  3.     local fila = `fila' + 1
  4. }
